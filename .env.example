# Copy to .env and fill in real values before production deploy.

ENVIRONMENT=development
DOCS_ENABLED=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_ENV_VAR
JWT_ISSUER=paygam-backend
JWT_AUDIENCE=paygam-clients
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Dev default SQLite. Production MUST use PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg://paygam:paygam@db:5432/paygam
DATABASE_URL=sqlite:///./paygam.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TEMPLATE_ENCRYPTION_KEY=

INTERNAL_SERVICE_KEY=CHANGE_ME_INTERNAL_SERVICE_KEY

EGOV_API_BASE_URL=https://api.egov.example.gov/v1
EGOV_API_KEY=CHANGE_ME
EGOV_TIMEOUT_SECONDS=8
EGOV_USE_MOCK=true

TELCO_API_BASE_URL=https://api.telco.example.gm/v1
TELCO_API_KEY=CHANGE_ME
TELCO_TIMEOUT_SECONDS=8
TELCO_USE_MOCK=true
TELCO_SIM_SWAP_LOOKBACK_DAYS=30

RISK_SCORE_BLOCK_THRESHOLD=0.85
RISK_SCORE_REVIEW_THRESHOLD=0.55
PAYMENTS_REQUIRE_EGOV_VERIFIED=false

CITIZEN_RISK_MIN_CONFIDENCE_MARGIN=0.08
CITIZEN_RISK_ROLLOUT=BANK=SHADOW,POLICE=SHADOW,COURT=SHADOW,DEFAULT=SHADOW
CITIZEN_RISK_DEVELOPMENT_ONLY=true
CITIZEN_RISK_MODEL_DIR=model_artifacts/citizen_risk
CITIZEN_RISK_TRAINING_SOURCE=synthetic
CITIZEN_RISK_ALLOW_SYNTHETIC_TRAIN_ON_BOOT=true
